# ============================================================
# AI Research Agent - Git Ignore
# ============================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class

# Python build / packaging
build/
dist/
*.egg-info/
.eggs/

# -------------------------
# Virtual Environment
# -------------------------
.venv/
venv/
env/
ENV/

# -------------------------
# Environment & Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# IDE / Editor
# -------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# -------------------------
# Logs
# -------------------------
*.log
logs/*
!logs/.gitkeep

# -------------------------
# Runtime / Temporary Data
# -------------------------
*.tmp
*.temp
*.cache
*.bak

# -------------------------
# Python Testing / Coverage
# -------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# -------------------------
# Type Checking
# -------------------------
.mypy_cache/
.pyre/
.pytype/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Local Application State
# -------------------------
state/*
!state/.gitkeep

# -------------------------
# Local Memory / Database
# -------------------------
memory/*.db
memory/*.sqlite
memory/*.sqlite3

# -------------------------
# OS Generated Files
# -------------------------
Thumbs.db
Desktop.ini

# -------------------------
# Temporary Research Files
# -------------------------
*.part
*.crdownload